{
  "name": "pi-code-review",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic multi-pass code review orchestration for Pi",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "code-review"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "pi": {
    "extensions": [
      "./extensions/code-review.ts"
    ],
    "skills": [
      "./skills/code-review"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@earendil-works/pi-tui": "0.84.3",
    "@types/node": "^25.5.0",
    "typebox": "1.3.7",
    "typescript": "^6.0.0",
    "vitest": "^4.0.18"
  }
}
