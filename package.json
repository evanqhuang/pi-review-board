{
  "name": "pi-review-board",
  "version": "0.1.0",
  "description": "Claude Code-style, deterministic multi-pass code review for Pi",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evanqhuang/pi-review-board.git"
  },
  "homepage": "https://github.com/evanqhuang/pi-review-board#readme",
  "bugs": {
    "url": "https://github.com/evanqhuang/pi-review-board/issues"
  },
  "license": "MIT",
  "files": [
    "extensions/",
    "src/",
    "skills/"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "code-review",
    "claude-code-style",
    "ai-agent",
    "developer-tools"
  ],
  "scripts": {
    "test": "vitest run --maxWorkers=1",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "pi": {
    "extensions": [
      "./extensions/code-review.ts"
    ],
    "skills": [
      "./skills/code-review"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@earendil-works/pi-tui": "0.84.3",
    "@types/node": "^25.5.0",
    "typebox": "1.3.7",
    "typescript": "^6.0.0",
    "vitest": "^4.0.18"
  }
}
